# ==============================================================================
# Environment Configuration for Data Contracts Shift-Left Platform
# ==============================================================================

# PostgreSQL Database Configuration (Used by Producer App, Runtime Quarantine, and dbt)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orders_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_SCHEMA=public

# Application Runtime Configuration
APP_ENV=production
CONTRACT_PATH=contract.json

# dbt Profiles and Target Configuration
DBT_PROFILES_DIR=./analytics
DBT_TARGET=dev
DBT_THREADS=4
